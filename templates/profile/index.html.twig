{% extends 'base.html.twig' %}

{% block title %}Mon Profil{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row">
        <!-- Colonne Gauche : Aperçu -->
        <div class="col-md-4 mb-4">
            <div class="card shadow border-0 text-center p-4">
                <div class="mb-3">
                    {% if user.photo %}
                        <img src="{{ asset('uploads/' ~ user.photo) }}" alt="Photo de profil" class="rounded-circle img-thumbnail" style="width: 150px; height: 150px; object-fit: cover;">
                    {% else %}
                        <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center mx-auto text-white" style="width: 150px; height: 150px; font-size: 3rem;">
                            {{ user.email|first|upper }}
                        </div>
                    {% endif %}
                </div>
                <h4 class="card-title">{{ user.email }}</h4>
                <p class="text-muted"><small>Membre depuis toujours</small></p>
                
                {% if user.bio %}
                    <hr>
                    <p class="card-text text-start font-italic">
                        <i class="bi bi-quote"></i> {{ user.bio }}
                    </p>
                {% endif %}
            </div>
        </div>

        <!-- Colonne Droite : Formulaire -->
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 px-4">
                    <h2 class="h4 mb-0">Modifier mes informations</h2>
                </div>
                <div class="card-body p-4">
                    
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success">
                            {{ message }}
                        </div>
                    {% endfor %}

                    {{ form_start(profileForm) }}
                        
                        <div class="mb-4">
                            {{ form_label(profileForm.bio, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(profileForm.bio, {'attr': {'class': 'form-control', 'placeholder': 'Parlez-nous un peu de vous...'}}) }}
                            {{ form_errors(profileForm.bio) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(profileForm.photo, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(profileForm.photo, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(profileForm.photo) }}
                            <div class="form-text">Formats acceptés : JPG, PNG. Max 2Mo.</div>
                        </div>

                        <hr class="my-4">
                        <h5 class="mb-3">Sécurité</h5>

                        <div class="mb-3">
                            <div id="profile-password-app" 
                                 data-input-name="{{ profileForm.newPassword.first.vars.full_name }}"
                                 data-input-id="{{ profileForm.newPassword.first.vars.id }}">
                            </div>
                            {% do profileForm.newPassword.first.setRendered %}
                            {{ form_errors(profileForm.newPassword.first) }}
                        </div>
                        <div class="mb-4">
                            {{ form_row(profileForm.newPassword.second, {'attr': {'class': 'form-control'}}) }}
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="submit" class="btn btn-primary px-5">
                                <i class="bi bi-save me-2"></i> Enregistrer les modifications
                            </button>
                        </div>

                    {{ form_end(profileForm) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
